{
  "name": "fredou-collection", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "art": "node scripts/generate-art.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:concurrency": "tsx --test tests/concurrency.test.ts",
    "test:e2e": "node scripts/browser-tests.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "next": "16.4.3", "react": "19.3.1", "react-dom": "19.3.1", "zod": "4.6.7", "lucide-react": "1.61.0" },
  "devDependencies": { "typescript": "^5.9.3", "@types/node": "^24", "@types/react": "^19", "@types/react-dom": "^19", "tsx": "4.23.15", "@playwright/test": "^1.56.1" }
}
