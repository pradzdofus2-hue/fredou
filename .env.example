# Copiez ce fichier en .env.local. Aucun identifiant n'est nécessaire en local.
APP_URL=http://localhost:3000
LOCAL_DEV_MODE=true
DATABASE_PATH=./data/fredou.sqlite
# OAuth réel facultatif. LOCAL_DEV_MODE=false pour désactiver les comptes fictifs.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
